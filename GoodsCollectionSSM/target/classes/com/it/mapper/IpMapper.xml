<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.it.mapper.IpMapper">

    <select id="findAll" resultType="com.it.entity.Ip">
        select *
        from goodscollection.ip
    </select>

    <select id="findById" resultType="string">
        select ipName from goodscollection.ip where ipId=#{ipId}
    </select>
</mapper>