<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.it.mapper.BrandMapper">

    <select id="findByBrandId" resultType="com.it.entity.Brand">
        select * from goodscollection.brand
                 where brandId=#{brandId}
    </select>

    <select id="findAllBrand" resultType="com.it.entity.Brand">
        select *
        from goodscollection.brand
    </select>
</mapper>