<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.it.mapper.PublishMapper">
    <select id="findAll" resultType="string">
       select goodsId
       from goodscollection.publish
       order by id desc
       limit #{pageSize} offset #{length}
    </select>

    <select id="findById" resultType="string">
        select goodsId
        from goodscollection.publish
        order by id desc
        <where>
            <if test="userId != null and userId !='' userId !='null'">
                userId=#{userId}
            </if>
        </where>
        limit #{pageSize} offset #{length}
    </select>

    <insert id="addNew" parameterType="com.it.entity.Publish">
        insert into goodscollection.publish(goodsId, userId)
        VALUES (#{goodsId},#{userId})
    </insert>

    <delete id="deleteById" parameterType="com.it.entity.Publish">
        delete from goodscollection.publish
               where userId=#{userId} and goodsId=#{goodsId}
    </delete>

    <delete id="delByGoodsId">
        delete from goodscollection.publish where goodsId=#{goodsId}
    </delete>

</mapper>