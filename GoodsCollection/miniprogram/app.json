    "pages/profile/profile",
    "pages/notice/notice",
    "pages/profileForm/profileForm",
    "pages/login/login",
    "pages/search/search",
    "pages/category/category",
    "pages/goods/goods",
    "pages/tag/tag",
    "pages/publish/publish",
    "pages/publishForm/publishForm",
