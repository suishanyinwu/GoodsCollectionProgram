      "iconPath": "/assets/tabber/favorites.png",
      "selectedIconPath": "/assets/tabber/favorites-active.png"
    },{
      "pagePath": "pages/profile/profile",
      "text": "我的",
      "iconPath": "/assets/tabber/profile.png",
